# GEMINI_API_KEY: Required for Gemini AI OCR extraction of PDF/image SAUM documents.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL of the deployed application on Vercel (e.g., https://sipenguji.vercel.app).
APP_URL="MY_APP_URL"

# DATABASE_URL: Managed PostgreSQL connection string (Neon / Supabase / Vercel Postgres).
# Example: postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/sipenguji?sslmode=require"

# SESSION_SECRET: Long random secret string for signing session tokens (min 32 characters).
SESSION_SECRET="replace-with-random-64-char-hex-secret"

# ADMIN_PASSCODE: Optional initial passcode for first-time Admin login.
# If left empty, an inline first-run Admin setup form lets you create the Admin account securely.
ADMIN_PASSCODE=""

# BLOB_READ_WRITE_TOKEN: Optional Vercel Blob token for permanent binary document storage.
# When omitted, uploaded binary documents are stored persistently inside PostgreSQL (BYTEA).
BLOB_READ_WRITE_TOKEN=""
